{
  "name": "json-render-docx",
  "version": "1.1.0",
  "description": "Render json-render specs to editable Word (.docx) files with real headings, lists, tables and page numbers.",
  "license": "MIT",
  "author": {
    "name": "Jan Tursky",
    "email": "jan.tursky@gmail.com",
    "url": "https://jantursky.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jantursky/json-render-office.git",
    "directory": "packages/json-render-docx"
  },
  "bugs": {
    "url": "https://github.com/jantursky/json-render-office/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "json-render",
    "docx",
    "word",
    "document",
    "generative-ui",
    "llm",
    "vue",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "dependencies": {
    "json-render-office": "^1.1.0",
    "vue-docx-document": "^1.0.2"
  },
  "peerDependencies": {
    "@json-render/core": "^0.23.1",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@arethetypeswrong/cli": "^0.18.5",
    "@json-render/core": "0.23.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "5.1.0",
    "fflate": "^0.8",
    "publint": "^0.3.25",
    "typescript": "~5.9.3",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "5.1.0",
    "vue": "^3.5.0",
    "zod": "^4.6.7"
  }
}

{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "bun run generate && blume dev",
    "build": "bun run generate && blume build",
    "preview": "blume preview",
    "doctor": "blume doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "bun run sync:changelog && node scripts/components.js",
    "sync:changelog": "mkdir -p docs/_generated && sed 1,2d ../../packages/json-render-report/CHANGELOG.md > docs/_generated/changelog.md"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.1",
    "blume": "^2.2.4",
    "json-render-docx": "workspace:*",
    "json-render-pptx": "workspace:*",
    "json-render-report": "workspace:*",
    "vue": "^3.5.0",
    "zod": "^4.6.7"
  }
}

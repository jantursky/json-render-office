{
  "name": "json-render-office-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun run --filter json-render-office build && bun run --filter json-render-pptx --filter json-render-docx build && bun run --filter json-render-report build",
    "build:apps": "bun run --filter example build",
    "build:docs": "bun run build && bun run --filter docs build",
    "test": "bun run --filter 'json-render-*' test",
    "test:coverage": "bun run --filter 'json-render-*' test:coverage",
    "test:oracle": "bun run --filter json-render-report test:oracle",
    "test:pack": "node scripts/pack-test.js",
    "test:e2e": "bun run build && bun run --filter example test:e2e",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:package": "bun run --filter 'json-render-*' lint:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "bun run --filter 'json-render-*' size",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@size-limit/esbuild": "^14",
    "@size-limit/file": "^14",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3",
    "size-limit": "^14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10"
  },
  "dependencies": {
    "@json-render/core": "0.23.1",
    "ai": "^7",
    "json-render-report": "workspace:*"
  }
}

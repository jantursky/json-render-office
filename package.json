{
  "name": "json-render-office-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun run --filter 'json-render-*' build",
    "test": "bun run --filter 'json-render-*' test",
    "test:coverage": "bun run --filter 'json-render-*' test:coverage",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10"
  }
}
